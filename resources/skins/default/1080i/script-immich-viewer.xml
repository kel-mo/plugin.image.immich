<?xml version="1.0" encoding="UTF-8"?>
<window>
  <coordinates>
    <left>0</left>
    <top>0</top>
  </coordinates>
  <controls>
    <control type="image" id="1">
      <width>1920</width>
      <height>1080</height>
      <texture colordiffuse="FF000000">white.png</texture>
    </control>

    <!-- two layers that take turns; each has a dimmed backdrop and a cover or fit image -->
    <control type="group" id="100">
      <control type="image" id="101">
        <width>1920</width>
        <height>1080</height>
        <aspectratio>scale</aspectratio>
        <colordiffuse>FF505050</colordiffuse>
      </control>
      <control type="image" id="102">
        <width>1920</width>
        <height>1080</height>
        <aspectratio>scale</aspectratio>
        <texture subpixel="true" diffuse="edge.png"/>
      </control>
      <control type="image" id="103">
        <width>1920</width>
        <height>1080</height>
        <aspectratio>keep</aspectratio>
        <texture subpixel="true" diffuse="edge.png"/>
      </control>
    </control>
    <control type="group" id="200">
      <control type="image" id="201">
        <width>1920</width>
        <height>1080</height>
        <aspectratio>scale</aspectratio>
        <colordiffuse>FF505050</colordiffuse>
      </control>
      <control type="image" id="202">
        <width>1920</width>
        <height>1080</height>
        <aspectratio>scale</aspectratio>
        <texture subpixel="true" diffuse="edge.png"/>
      </control>
      <control type="image" id="203">
        <width>1920</width>
        <height>1080</height>
        <aspectratio>keep</aspectratio>
        <texture subpixel="true" diffuse="edge.png"/>
      </control>
    </control>

    <control type="videowindow" id="2">
      <width>1920</width>
      <height>1080</height>
      <visible>String.IsEqual(Window.Property(immich.video),true)</visible>
    </control>

    <!-- details, toggled with Info -->
    <control type="group">
      <left>1240</left>
      <top>140</top>
      <visible>String.IsEqual(Window.Property(immich.details),true)</visible>
      <animation effect="fade" time="300">VisibleChange</animation>
      <control type="image" id="301">
        <width>620</width>
        <height>560</height>
        <texture colordiffuse="B0000000">white.png</texture>
      </control>
      <control type="textbox">
        <left>36</left>
        <top>30</top>
        <width>548</width>
        <height>500</height>
        <font>font13</font>
        <textcolor>EEFFFFFF</textcolor>
        <label>$INFO[Window.Property(immich.detail)]</label>
      </control>
    </control>

    <!-- caption -->
    <control type="group">
      <visible>String.IsEqual(Window.Property(immich.captions),true) + !String.IsEmpty(Window.Property(immich.date))</visible>
      <animation effect="fade" time="400">VisibleChange</animation>
      <control type="image">
        <top>880</top>
        <width>1920</width>
        <height>200</height>
        <texture>shade.png</texture>
      </control>
      <control type="label">
        <left>80</left>
        <top>970</top>
        <width>400</width>
        <height>40</height>
        <font>font13</font>
        <textcolor>DDFFFFFF</textcolor>
        <shadowcolor>AA000000</shadowcolor>
        <label>$INFO[Window.Property(immich.date)]</label>
      </control>
      <control type="label">
        <left>480</left>
        <top>970</top>
        <width>960</width>
        <height>40</height>
        <align>center</align>
        <font>font13</font>
        <textcolor>DDFFFFFF</textcolor>
        <shadowcolor>AA000000</shadowcolor>
        <label>$INFO[Window.Property(immich.place)]</label>
      </control>
      <control type="label">
        <right>80</right>
        <top>970</top>
        <width>400</width>
        <height>40</height>
        <align>right</align>
        <font>font13</font>
        <textcolor>DDFFFFFF</textcolor>
        <shadowcolor>AA000000</shadowcolor>
        <label>$INFO[Window.Property(immich.position)]</label>
      </control>
    </control>

    <control type="label">
      <right>80</right>
      <top>50</top>
      <width>400</width>
      <height>60</height>
      <align>right</align>
      <font>font45</font>
      <textcolor>DDFFFFFF</textcolor>
      <shadowcolor>AA000000</shadowcolor>
      <label>$INFO[System.Time]</label>
      <visible>String.IsEqual(Window.Property(immich.clock),true) + String.IsEmpty(Window.Property(immich.video))</visible>
    </control>

    <control type="label">
      <left>80</left>
      <top>50</top>
      <width>800</width>
      <height>40</height>
      <font>font13</font>
      <textcolor>DDFFFFFF</textcolor>
      <shadowcolor>AA000000</shadowcolor>
      <label>$INFO[Window.Property(immich.status)]</label>
      <animation effect="fade" time="300">VisibleChange</animation>
      <visible>!String.IsEmpty(Window.Property(immich.status))</visible>
    </control>
  </controls>
</window>
